# Pub reads this file INSTEAD of .gitignore in this directory -- not in
# addition to it -- so everything .gitignore excludes has to be repeated here
# or it starts shipping the day this file lands.
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
local.properties
.DS_Store
Pods/
Podfile.lock
.symlinks/

__pycache__/
.pytest_cache/
.ruff_cache/

# Repo tooling. The E2E matrix runner needs a device rig and an env file; it is
# no use to a merchant, and pana would score its fixtures as if they were
# library code.
tool/

# Kotlin's build-session scratch directory, written by any Gradle run in
# example/android. A build artifact, not a source file.
.kotlin/

# Signing material for the demo app. Repeated from .gitignore because pub reads
# this file INSTEAD of that one: a .gitignore-only rule protects git and would
# not protect a publish. *.p12 is the one that matters now the store is PKCS12.
key.properties
*.jks
*.p12
*.keystore
# Campaign and readiness reports; pub warned that a top-level docs/ is not the
# package layout it expects, and none of it belongs in the published archive.
docs/
